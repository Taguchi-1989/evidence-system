{
  "name": "evidence-system",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [5173, 8787, 4566],
  "portsAttributes": {
    "5173": { "label": "Web (Vite)" },
    "8787": { "label": "API (Hono)" },
    "4566": { "label": "LocalStack" }
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.18.3 --activate && pnpm install && node scripts/ensure-env.mjs",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
