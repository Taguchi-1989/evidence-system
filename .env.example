# ───────────────────────────────────────────────────────────────
# 成果・証跡管理システム 環境変数サンプル
# ローカル開発では `.env` にコピーして使用。
# 本番(AWS)へ移行する場合はこのファイルの値を AWS の実値に差し替えるだけ。
# ───────────────────────────────────────────────────────────────

# --- 実行環境フラグ ---
NODE_ENV=development

# --- ストレージ駆動方式 ---
# aws   : DynamoDB + S3（LocalStack もこれ。Docker 必要）
# local : ファイル/メモリ + ローカルFS（Docker 不要の最小モード。`pnpm setup:local`）
STORAGE_DRIVER=aws
# local モードのデータ保存先
LOCAL_DATA_DIR=.localdata

# --- AWS / ストレージ共通 ---
AWS_REGION=ap-northeast-1
# ローカル(LocalStack)では http://localhost:4566 を指定。
# 本番では空にすると AWS の実エンドポイントに接続する。
AWS_ENDPOINT_URL=http://localhost:4566
# LocalStack はダミー認証情報で動作する。本番では IAM ロール/環境変数を使用。
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# --- DynamoDB ---
DDB_TABLE_NAME=evidence-system

# --- S3 ---
S3_BUCKET=evidence-bucket
# presigned URL の有効期限（秒）
S3_PRESIGN_EXPIRES=300
# LocalStack は path-style addressing が必要（バーチャルホスト形式は不可）
S3_FORCE_PATH_STYLE=true
# ブラウザから直アクセスする際の S3 公開エンドポイント（ローカルは LocalStack）
S3_PUBLIC_ENDPOINT=http://localhost:4566

# --- 認証 ---
# mock | cognito
AUTH_PROVIDER=mock
# Cognito を使う場合のみ（本番）
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=ap-northeast-1

# --- API サーバ ---
API_PORT=8787
# CORS 許可オリジン（フロント開発サーバ）
CORS_ORIGIN=http://localhost:5173

# --- 監査 Agent (任意) ---
# LLM を使う場合のみ設定。未設定(none)なら構造チェックのみで動作する。
# none | anthropic | azure-openai
AUDIT_LLM_PROVIDER=none
# anthropic を使う場合
ANTHROPIC_API_KEY=
# azure-openai を使う場合（今後の本命）
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- 外部Agentソフト連携（API連携） ---
# サービス認証用 APIキー（カンマ区切り）。Authorization: Bearer <key> で API を叩ける。
AGENT_API_KEYS=
# APIキー認証で付与するロール。既定 auditor=read系のみ（セキュアデフォルト）。
# export/監査実行/取込/承認まで許可するなら office、全権なら admin。
AGENT_API_ROLE=auditor

# --- フロントエンド (Vite, VITE_ prefix のみブラウザへ露出) ---
VITE_API_BASE_URL=http://localhost:8787
